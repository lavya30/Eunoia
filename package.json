{
  "name": "eunoia",
  "private": true,
  "description": "Eunoia — Architecture Whiteboard & D2 Diagram Canvas",
  "license": "MIT",
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"bun run dev:frontend\" \"bun run dev:sync\" \"bun run dev:db\"",
    "dev:frontend": "bun --cwd frontend dev",
    "dev:sync": "bun --filter ./packages/sync-server dev",
    "dev:db": "docker compose up -d postgres redis",
    "build": "bun run --filter ./packages/sync-server build",
    "lint": "bun --filter ./packages/sync-server lint",
    "typecheck": "bun --filter ./packages/sync-server typecheck",
    "test": "bun test",
    "prisma": "bun --filter ./packages/sync-server prisma:generate",
    "prisma:generate": "bun --filter ./packages/sync-server prisma:generate"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "packageManager": "bun@1.4.0"
}
