generator client {
  provider      = "prisma-client-js"
  // "native" covers dev machines; the musl build covers the alpine runtime
  // image (node:20-alpine + openssl).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  COMMUNITY
  PRO
  ENTERPRISE
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  passwordHash String?
  tier         Tier          @default(COMMUNITY)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subscription Subscription?
}

model Room {
  id              String       @id
  name            String
  ownerId         String
  tier            Tier         @default(COMMUNITY)
  passwordHash    String?
  passwordVersion Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  snapshots       Snapshot[]
  imageAssets     ImageAsset[]

  @@index([ownerId])
}

model Snapshot {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  docVersion String
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([roomId, createdAt])
}

model ImageAsset {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  key         String   @unique
  url         String
  contentType String
  size        Int?
  kind        String   @default("image")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([roomId])
  @@index([roomId, kind])
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String    @default("razorpay")
  customerId    String?
  providerSubId String?
  status        String    @default("active")
  priceKey      String
  seats         Int       @default(1)
  periodEnd     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([customerId])
}

model BillingEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  createdAt DateTime @default(now())
}
