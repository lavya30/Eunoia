# ── Server ──────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ── Database ────────────────────────────────────────────
# PostgreSQL connection string (production)
# For local dev without Docker, use SQLite: file:./dev.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eunoia?schema=public"
# SQLite fallback for local dev:git
# DATABASE_URL="file:./dev.db"

# ── Redis (cursor telemetry) ────────────────────────────
# Redis for cursor pub/sub. Leave empty to disable cursor telemetry
# (sync still works, just no live cursors)
REDIS_URL=redis://localhost:6379

# ── D2 Compiler Microservice ────────────────────────────
# HTTP endpoint of the external Go D2 compiler service
# Leave empty to use placeholder mode (returns sample layout)
D2_COMPILER_URL=http://localhost:9400
# Max nodes per diagram for COMMUNITY tier compiles (elk/tala need PRO+)
D2_COMMUNITY_NODE_LIMIT=30

# ── Snapshot Settings ───────────────────────────────────
# Debounce delay (ms) before flushing Y.Doc snapshot to DB
SNAPSHOT_DEBOUNCE_MS=2000

# Idle timeout (ms) before unloading a room from memory
ROOM_IDLE_TIMEOUT_MS=300000

# ── Snapshot retention ──────────────────────────────────
# Snapshots kept per room (newest count) plus retention window in days.
# The newest snapshot is always kept; history APIs list/restore the rest.
SNAPSHOT_MAX_PER_ROOM=100
SNAPSHOT_RETENTION_DAYS=30

# ── Cloudflare R2 (image assets) ──────────────────────────
# Image bytes live in R2; Postgres keeps metadata only.
# Leave unset to disable image endpoints (they return 503).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eunoia-images
# Optional public base URL (e.g. https://images.example.com). When set,
# stored URLs are public; otherwise per-request signed URLs are issued.
R2_PUBLIC_BASE_URL=
# Max accepted upload size in bytes
R2_MAX_UPLOAD_BYTES=10000000
# Signed URL lifetime in seconds
R2_URL_EXPIRES_IN_SEC=900
